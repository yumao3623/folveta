# 忽略本地依赖、构建产物、测试输出与敏感配置。

# 依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 测试产物
/coverage
/playwright-report/
/test-results/
/.workflow-data/
/.workflow-vitest/

# Next.js 构建产物
/.next/
/out/

# 其他构建输出
/build

# 系统杂项与私钥、证书
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.der
*.cer
*.crt
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*

# 本地密钥与凭据
secrets/
credentials/
.netrc
.git-credentials
.pypirc
.npmrc.local
*.secret.local
*.secrets.local
*.credentials.local

# 本地缓存与临时文件
/.cache/
/.tmp/
/tmp/
*.tmp
*.temp
*.swp
*.swo
*~

# 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 环境文件：仅提交不含真实密钥的示例
.env*
!.env.example

# Vercel 本地链接状态
.vercel

# Supabase CLI 本地链接状态
/supabase/.temp/

# TypeScript 与编译缓存
*.tsbuildinfo
next-env.d.ts
/.swc
