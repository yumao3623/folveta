{
  "name": "study-guide-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workflow": "vitest run --config vitest.workflow.config.mts",
    "test:watch": "vitest",
    "fixtures:generate": "node scripts/generate-test-fixtures.mjs",
    "e2e:product-3b:setup": "node --env-file=.env.local scripts/product-3b-e2e.mjs setup",
    "e2e:product-3b:verify": "node --env-file=.env.local scripts/product-3b-e2e.mjs verify",
    "e2e:product-3b:cleanup": "node --env-file=.env.local scripts/product-3b-e2e.mjs cleanup",
    "e2e:product-3c:setup": "node --env-file=.env.local scripts/product-3c-e2e.mjs setup",
    "e2e:product-3c:verify": "node --env-file=.env.local scripts/product-3c-e2e.mjs verify",
    "e2e:product-3c:cleanup": "node --env-file=.env.local scripts/product-3c-e2e.mjs cleanup"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.3",
    "file-type": "^22.0.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "officeparser": "^7.8.0",
    "openai": "^7.5.0",
    "ppt-to-text": "^1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "unpdf": "^1.8.1",
    "workflow": "^4.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workflow/vitest": "^4.0.21",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "pdfjs-dist": "6.2.108"
  }
}
