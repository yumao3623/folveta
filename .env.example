# 首次配置模板；复制后在本地填写，已有 .env.local 时不要覆盖。
# 网站域名、索引开关、Supabase 账户与私有存储；service role 仅服务端使用。
NEXT_PUBLIC_SITE_URL=
PRELAUNCH=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=course-materials
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials

# 结构化输出模型服务；模型名称由实际服务商配置决定。
MODEL_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_TOPIC_EXTRACT=
MODEL_TOPIC_MERGE=
MODEL_GUIDE=
MODEL_GROUNDING_VERIFY=
MODEL_QUICK_CHECK=
MODEL_QUESTION_VERIFY=
MODEL_CONTEXT_WINDOW_TOKENS=128000
GATEWAY_MAX_INPUT_TOKENS=80000
AI_GENERATION_WORKFLOW_ENABLED=false
GENERATION_V2_RUNTIME_ENABLED=false
CRON_SECRET=

# Paddle 测试环境；以下产品与价格 ID 仅为 Sandbox 默认配置。
# 正式环境需匹配 Live 配置；API key 和 Webhook secret 仅服务端使用。
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=pro_01m1b264s0fbx0r5dbwq0e03aa
PADDLE_PRICE_ID=pri_01m1b26517pap7d484ngr7746a

# 提示词/数据结构版本与保留天数；这些内部版本不随网站 1.0/2.0 编号调整。
PROMPT_VERSION=phase1-v1
GUIDE_SCHEMA_VERSION=1.0
QUICK_CHECK_SCHEMA_VERSION=1.0
SESSION_RETENTION_DAYS=7
RETENTION_JOB_SECRET=
